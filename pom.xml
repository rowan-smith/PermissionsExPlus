<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.rono.permissions</groupId>
    <artifactId>PexPlus</artifactId>
    <version>2.0.0-SNAPSHOT</version>

    <packaging>pom</packaging>

    <modules>
        <module>PermissionsExApiAdapter</module>
        <module>PermissionsExCommandAdapter</module>
        <module>PermissionsExPlus</module>
        <module>PermissionsExPlusApi</module>
        <module>Test</module>
        <module>Test2</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>11</maven.compiler.release>
        <junit.version>5.11.4</junit.version>
        <dbcp.version>2.13.0</dbcp.version>
        <maven.compiler.plugin.version>3.15.0</maven.compiler.plugin.version>
        <maven.shade.plugin.version>3.6.2</maven.shade.plugin.version>
        <maven.surefire.plugin.version>3.5.5</maven.surefire.plugin.version>
        <maven.source.plugin.version>3.4.0</maven.source.plugin.version>
        <maven.javadoc.plugin.version>3.12.0</maven.javadoc.plugin.version>
        <maven.gpg.plugin.version>3.2.8</maven.gpg.plugin.version>
        <spotless.plugin.version>2.44.5</spotless.plugin.version>
        <cloud.version>2.0.0-beta.17</cloud.version>
        <mockbukkit.version>4.110.0</mockbukkit.version>
    </properties>

    <issueManagement>
        <system>GitHub</system>
        <url>https://github.com/rowan-smith/PermissionsExPlus/issues</url>
    </issueManagement>

    <repositories>
        <repository>
            <id>central</id>
            <url>https://repo.maven.apache.org/maven2</url>
        </repository>
        <repository>
            <id>spigot-repo</id>
            <url>https://hub.spigotmc.org/nexus/content/groups/public/</url>
        </repository>
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
        <repository>
            <id>mojang</id>
            <url>https://libraries.minecraft.net/</url>
        </repository>
        <repository>
            <id>codemc-repo</id>
            <url>https://repo.codemc.io/repository/maven-public/</url>
        </repository>
    </repositories>

    <build>
        <plugins>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless.plugin.version}</version>
                <configuration>
                    <java>
                        <eclipse>
                            <version>4.35</version>
                            <file>${maven.multiModuleProjectDirectory}/config/eclipse-java-formatter.xml</file>
                        </eclipse>
                        <indent>
                            <spaces>true</spaces>
                        </indent>
                        <trimTrailingWhitespace/>
                        <formatAnnotations/>
                        <removeUnusedImports/>
                        <replaceRegex>
                            <name>no blank line before closing braces</name>
                            <searchRegex>(?m)(\R)[^\S\r\n]*\R(?=[^\S\r\n]*})</searchRegex>
                            <replacement>$1</replacement>
                        </replaceRegex>
                        <replaceRegex>
                            <name>blank line after compound statements</name>
                            <searchRegex>(?m)^(\s*})(\R)(?=[^\S\r\n]*(?!(?:[})]|else\b|catch\b|finally\b))\S)</searchRegex>
                            <replacement>$1$2$2</replacement>
                        </replaceRegex>
                        <endWithNewline/>
                    </java>
                </configuration>
                <executions>
                    <execution>
                        <id>java-style</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
