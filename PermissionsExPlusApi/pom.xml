<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>dev.rono.permissions</groupId>
        <artifactId>PexPlus</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>PermissionsExPlusApi</artifactId>

    <properties>
        <maven.compiler.release>26</maven.compiler.release>
        <maven.compiler.source>26</maven.compiler.source>
        <maven.compiler.target>26</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.jetbrains</groupId>
            <artifactId>annotations</artifactId>
            <version>26.1.0</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven.surefire.plugin.version}</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>${maven.javadoc.plugin.version}</version>
                <configuration>
                    <source>${maven.compiler.source}</source>
                    <doclint>none</doclint>
                    <quiet>true</quiet>
                    <windowtitle>PermissionsExPlus API</windowtitle>
                    <doctitle>PermissionsExPlus API ${project.version}</doctitle>
                    <bottom>Copyright &#169; ${project.inceptionYear}&#8211;${currentYear} rowan-smith. All rights reserved.</bottom>
                    <groups>
                        <group>
                            <title>API</title>
                            <packages>dev.rono.permissions.api</packages>
                        </group>
                        <group>
                            <title>Context</title>
                            <packages>dev.rono.permissions.api.context</packages>
                        </group>
                        <group>
                            <title>Groups</title>
                            <packages>dev.rono.permissions.api.group</packages>
                        </group>
                        <group>
                            <title>Users</title>
                            <packages>dev.rono.permissions.api.user</packages>
                        </group>
                        <group>
                            <title>Permissions</title>
                            <packages>dev.rono.permissions.api.permission</packages>
                        </group>
                        <group>
                            <title>Options</title>
                            <packages>dev.rono.permissions.api.options</packages>
                        </group>
                        <group>
                            <title>Resolver</title>
                            <packages>dev.rono.permissions.api.resolver</packages>
                        </group>
                        <group>
                            <title>Ladders</title>
                            <packages>dev.rono.permissions.api.ladder</packages>
                        </group>
                        <group>
                            <title>Events</title>
                            <packages>dev.rono.permissions.api.event</packages>
                        </group>
                        <group>
                            <title>Platform</title>
                            <packages>dev.rono.permissions.api.platform</packages>
                        </group>
                    </groups>
                </configuration>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
