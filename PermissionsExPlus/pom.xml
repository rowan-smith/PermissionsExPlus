<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.rono.permissions</groupId>
        <artifactId>PexPlus</artifactId>
        <version>2.0.0-SNAPSHOT</version>
    </parent>

    <modules>
        <module>Core</module>
        <module>BukkitCommon</module>
        <module>Spigot</module>
        <module>Paper</module>
        <module>SpigotLegacy</module>
        <module>Bukkit17</module>
        <module>Sponge7</module>
        <module>Sponge8</module>
        <module>Sponge9</module>
        <module>Sponge11</module>
        <module>Velocity</module>
        <module>BungeeCord</module>
    </modules>

    <artifactId>PermissionsExPlus</artifactId>
    <packaging>pom</packaging>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <hikari.version>4.0.3</hikari.version>
        <testcontainers.version>1.21.3</testcontainers.version>
        <!-- H2 for Java 17+ distributions, and the last release that runs on Java 8. -->
        <h2.version>2.3.232</h2.version>
        <h2.legacy.version>2.1.214</h2.legacy.version>
        <configurate.version>4.2.0</configurate.version>
        <sqlite.version>3.49.0.0</sqlite.version>
        <postgres.version>42.7.7</postgres.version>
        <mysql.version>9.3.0</mysql.version>
        <jedis.version>5.2.0</jedis.version>
        <!-- 2.9.x is the last Caffeine line that runs on Java 8. -->
        <caffeine.version>2.9.3</caffeine.version>
        <jcasbin.version>1.99.0</jcasbin.version>
    </properties>

    <dependencyManagement>
        <dependencies>

            <dependency>
                <groupId>cloud.commandframework</groupId>
                <artifactId>cloud-bom</artifactId>
                <version>1.8.4</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

        </dependencies>
    </dependencyManagement>

</project>
